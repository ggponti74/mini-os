Generating initrd.tar...
tar -cvf initrd.tar -C initrd_root .
./
./system.cfg
./readme.txt
gcc -m32 -ffreestanding -fno-pie -fno-pic -fno-stack-protector -c -O2 -Ikernel kernel/fs/initrd_data.S -o build/fs/initrd_data.o
gcc -m32 -ffreestanding -fno-pie -fno-pic -fno-stack-protector -c -O2 -Ikernel kernel/main.c -o build/main.o
gcc -m32 -nostdlib -no-pie -Wl,--build-id=none -Wl,-e,stage2_entry -Wl,-Map=build/linker.map -T linker.ld -o build/kernel.elf build/kernel_entry.o build/interrupts.o build/fs/initrd_data.o build/display.o build/idt.o build/keyboard.o build/main.o build/memory.o build/pic.o build/posix.o build/shell.o build/sound.o build/string.o build/vga.o build/fs/initrd.o build/fs/vfs.o build/hal/memory.o build/network/network.o build/sys/metrics.o
objcopy -O binary build/kernel.elf build/kernel.bin
cat build/boot.bin build/kernel.bin > dist/mini-os.img
truncate -s 1474560 dist/mini-os.img
cp dist/mini-os.img build/iso_root/mini-os.img
xorriso -as mkisofs -b mini-os.img -o dist/mini-os.iso build/iso_root
