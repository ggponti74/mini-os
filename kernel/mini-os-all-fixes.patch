diff --git a/scripts/smoke-test.sh b/scripts/smoke-test.sh
old mode 100644
new mode 100755
index e69de29..81de359
--- a/scripts/smoke-test.sh
+++ b/scripts/smoke-test.sh
@@ -0,0 +1,17 @@
+#!/bin/sh
+# Boot the ISO headless, type "help" over the serial console, check the output.
+# Usage: scripts/smoke-test.sh [path/to/mini-os.iso]
+ISO="${1:-dist/mini-os.iso}"
+OUT="$(mktemp)"
+trap 'rm -f "$OUT"' EXIT
+
+( sleep 4; printf 'help\r'; sleep 2 ) | timeout 15 qemu-system-i386 \
+    -cdrom "$ISO" -boot d -display none -serial stdio -monitor none -no-reboot \
+    > "$OUT" 2>&1
+
+fail=0
+for pat in "System ready" "mini-os>" "Available commands"; do
+    if grep -q "$pat" "$OUT"; then echo "PASS: found '$pat'"; else echo "FAIL: missing '$pat'"; fail=1; fi
+done
+[ "$fail" -eq 0 ] || { echo "---- serial output ----"; cat -v "$OUT"; }
+exit "$fail"
